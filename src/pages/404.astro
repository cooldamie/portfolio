---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title="Page not found" noindex>
  <header class="container top">
    <a class="wordmark" href="/">
      {site.brand}
    </a>
  </header>
  <main id="main" class="container body" tabindex="-1">
    <p class="code">404</p>
    <h1>This page doesn't exist.</h1>
    <p>
      It may have moved while the site is being built. The home page has everything that's live.
    </p>
    <p>
      <a href="/">Go to the home page</a>
    </p>
  </main>
</Base>

<style>
  .top {
    padding-block: var(--space-5);
  }

  .wordmark {
    font-family: var(--f-display);
    font-stretch: var(--display-stretch);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-7) var(--space-9);
    max-width: calc(var(--measure) + 2 * var(--space-6));
    outline: none;
  }

  .code {
    font-family: var(--f-mono);
    color: var(--accent);
  }

  h1 {
    font-family: var(--f-display);
    font-stretch: var(--display-stretch);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: var(--step-3);
    line-height: 1.1;
  }
</style>

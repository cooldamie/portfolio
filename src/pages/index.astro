---
// Phase 0 placeholder: proves the pipeline end to end and gives visitors a real first impression.
// The full home page (case studies, capabilities, notes) replaces this in Phase 3.
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base>
  <header class="container top">
    <a class="wordmark" href="/">
      {site.brand}
    </a>
  </header>

  <main id="main" class="container hero" tabindex="-1">
    <p class="status">
      <span class="dot" aria-hidden="true"></span>
      {site.availability}
    </p>
    <p class="eyebrow">
      {site.name} · {site.role}
    </p>
    <h1>I build the systems regulated businesses run on, and I stay through go-live.</h1>
    <p class="lede">
      Full-stack engineer and IT consultant for banking, risk and operations platforms, working
      across .NET, Angular, TypeScript and Azure.
    </p>

    <nav class="paths" aria-label="Ways to work together">
      <a class="path" href={site.links.linkedin} rel="me noopener" target="_blank">
        <span class="path-title">Work with me</span>
        <span class="path-note">Advisory, delivery, build</span>
      </a>
      <a class="path" href={site.links.linkedin} rel="me noopener" target="_blank">
        <span class="path-title">Hire me</span>
        <span class="path-note">Full-time, remote</span>
      </a>
    </nav>

    <p class="note">
      The full site is being built in the open. Until it launches, both paths lead to LinkedIn.
    </p>
  </main>
</Base>

<style>
  .top {
    padding-block: var(--space-5);
  }

  .wordmark {
    font-family: var(--f-display);
    font-stretch: var(--display-stretch);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }

  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-3) var(--space-9);
    outline: none;
  }

  @media (min-width: 768px) {
    .hero {
      gap: var(--space-5);
      padding-top: var(--space-6);
    }
  }

  /* Faint construction grid that fades out downwards. */
  .hero::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--space-6)) 0 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(to bottom, #000 0%, rgb(0 0 0 / 0.5) 50%, transparent 100%);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    padding: var(--space-1) var(--space-3) var(--space-1) var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent);
  }

  .eyebrow {
    font-family: var(--f-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    max-width: 20ch;
    font-family: var(--f-display);
    font-stretch: var(--display-stretch);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-tracking);
    font-size: var(--step-4);
    line-height: 1.04;
  }

  .lede {
    max-width: 56ch;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    max-width: 560px;
  }

  .path {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 44px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--accent);
    border-radius: var(--r-m);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color var(--dur-2) var(--ease),
      transform var(--dur-1) var(--ease);
  }

  .path:hover {
    background: var(--accent-soft);
  }

  .path:active {
    transform: scale(0.98);
  }

  .path-title {
    font-weight: 600;
  }

  .path-title::after {
    content: ' →';
    color: var(--accent);
  }

  .path-note {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .note {
    max-width: 56ch;
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
